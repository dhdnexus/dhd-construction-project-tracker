rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isExistingDocOwner() {
      return isAuthenticated() && resource != null && resource.data.ownerId == request.auth.uid;
    }

    function isCreatingWithOwner() {
      return isAuthenticated() &&
        request.resource != null &&
        request.resource.data.ownerId == request.auth.uid;
    }

    function isOwnerImmutable() {
      return resource == null ||
        request.resource == null ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == request.resource.data.ownerId;
    }

    function isProjectImmutable() {
      return resource == null ||
        request.resource == null ||
        !('projectId' in resource.data) ||
        resource.data.projectId == request.resource.data.projectId;
    }

    function isUserProject(projId) {
      return exists(/databases/$(database)/documents/projects/$(projId)) &&
        get(/databases/$(database)/documents/projects/$(projId)).data.ownerId == request.auth.uid;
    }

    function isProjectDeletionAuthorized(projId) {
      return exists(/databases/$(database)/documents/projectDeletionIntents/$(projId)) &&
        get(/databases/$(database)/documents/projectDeletionIntents/$(projId)).data.ownerId == request.auth.uid &&
        get(/databases/$(database)/documents/projectDeletionIntents/$(projId)).data.projectId == projId &&
        get(/databases/$(database)/documents/projectDeletionIntents/$(projId)).data.entityType == 'ProjectDeletionIntent';
    }

    function isValidProjectMaterial(materialId, projId) {
      return materialId is string &&
        exists(/databases/$(database)/documents/materials/$(materialId)) &&
        get(/databases/$(database)/documents/materials/$(materialId)).data.ownerId == request.auth.uid &&
        get(/databases/$(database)/documents/materials/$(materialId)).data.projectId == projId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdminMaterialDeletionAuthorized(projId, materialId) {
      return projId is string &&
        materialId is string &&
        isAdmin() &&
        exists(/databases/$(database)/documents/adminMaterialDeletionIntents/$(materialId)) &&
        get(/databases/$(database)/documents/adminMaterialDeletionIntents/$(materialId)).data.adminUid == request.auth.uid &&
        get(/databases/$(database)/documents/adminMaterialDeletionIntents/$(materialId)).data.projectId == projId &&
        get(/databases/$(database)/documents/adminMaterialDeletionIntents/$(materialId)).data.materialId == materialId &&
        get(/databases/$(database)/documents/adminMaterialDeletionIntents/$(materialId)).data.entityType == 'AdminMaterialDeletionIntent';
    }

    function isAdminPurchaseDeletionAuthorized(purchaseId) {
      return isAdmin() &&
        exists(/databases/$(database)/documents/adminPurchaseDeletionIntents/$(purchaseId)) &&
        get(/databases/$(database)/documents/adminPurchaseDeletionIntents/$(purchaseId)).data.adminUid == request.auth.uid &&
        get(/databases/$(database)/documents/adminPurchaseDeletionIntents/$(purchaseId)).data.purchaseId == purchaseId &&
        get(/databases/$(database)/documents/adminPurchaseDeletionIntents/$(purchaseId)).data.entityType == 'AdminPurchaseDeletionIntent';
    }

    function isAdminTransactionDeletionAuthorized(entityType, entityId) {
      return isAdmin() &&
        entityId is string &&
        exists(/databases/$(database)/documents/adminTransactionDeletionIntents/$(entityId)) &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(entityId)).data.adminUid == request.auth.uid &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(entityId)).data.entityType == entityType &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(entityId)).data.entityId == entityId &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(entityId)).data.projectId == resource.data.projectId;
    }

    function isAdminMaterialReconciliationAuthorized(materialId) {
      return isAdmin() &&
        materialId is string &&
        exists(/databases/$(database)/documents/adminTransactionDeletionIntents/$(materialId)) &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(materialId)).data.adminUid == request.auth.uid &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(materialId)).data.reconciliationMaterialId == materialId &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(materialId)).data.projectId == resource.data.projectId;
    }

    function isAdminContractorReconciliationAuthorized(contractorId) {
      return isAdmin() &&
        contractorId is string &&
        exists(/databases/$(database)/documents/adminTransactionDeletionIntents/$(contractorId)) &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(contractorId)).data.adminUid == request.auth.uid &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(contractorId)).data.reconciliationContractorId == contractorId &&
        get(/databases/$(database)/documents/adminTransactionDeletionIntents/$(contractorId)).data.projectId == resource.data.projectId;
    }

    // 0. User profiles
    // Regular accounts may create their own profile only with the non-privileged user role.
    // Administrator profiles are provisioned outside the client application.
    match /userProfiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'user';
      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        resource.data.role == request.resource.data.role;
      allow delete: if false;
    }

    // 1. Durable project deletion intents
    // A deletion intent must be created by the authenticated project owner before
    // the project document can be deleted. The intent is kept separate from the
    // immutable audit event stream so its document ID can safely be the project ID.
    match /projectDeletionIntents/{projectId} {
      allow read: if isExistingDocOwner();
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.ownerId &&
        request.resource.data.projectId == projectId &&
        request.resource.data.entityType == 'ProjectDeletionIntent' &&
        isUserProject(projectId);
      allow update: if false;
      allow delete: if isExistingDocOwner();
    }

    // 2. Projects
    match /projects/{projectId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner();
      allow update: if isExistingDocOwner() && isCreatingWithOwner() && isOwnerImmutable();
      allow delete: if isExistingDocOwner() && isProjectDeletionAuthorized(projectId);
    }

    // 3. Administrator material deletion intents
    // A material purge requires a short-lived, administrator-created intent.
    match /adminMaterialDeletionIntents/{intentId} {
      allow read: if isAdmin() && resource.data.adminUid == request.auth.uid;
      allow create: if isAdmin() &&
        request.resource.data.entityType == 'AdminMaterialDeletionIntent' &&
        request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.projectId is string &&
        request.resource.data.materialId is string &&
        request.resource.data.ownerId is string &&
        exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) &&
        get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.resource.data.ownerId;
      allow update: if false;
      allow delete: if isAdmin() && resource.data.adminUid == request.auth.uid;
    }

    // 3b. Administrator purchase deletion intents used to authorize linked transport cleanup.
    match /adminPurchaseDeletionIntents/{purchaseId} {
      allow read: if isAdmin() && resource.data.adminUid == request.auth.uid;
      allow create: if isAdmin() &&
        request.resource.data.entityType == 'AdminPurchaseDeletionIntent' &&
        request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.purchaseId == purchaseId &&
        request.resource.data.projectId is string &&
        request.resource.data.materialId is string;
      allow update: if false;
      allow delete: if isAdmin() && resource.data.adminUid == request.auth.uid;
    }

    // 3c. Administrator transaction deletion intents.
    // Destructive removal of recorded financial/operational history requires an
    // explicit administrator intent. The client creates the intent immediately
    // before the destructive write and removes it after completion.
    match /adminTransactionDeletionIntents/{intentId} {
      allow read: if isAdmin() && resource.data.adminUid == request.auth.uid;
      allow create: if isAdmin() &&
        request.resource.data.entityType is string &&
        request.resource.data.entityId == intentId &&
        request.resource.data.entityId is string &&
        request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.projectId is string &&
        request.resource.data.ownerId is string &&
        exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) &&
        get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.resource.data.ownerId;
      allow update: if false;
      allow delete: if isAdmin() && resource.data.adminUid == request.auth.uid;
    }

    // 4. Materials
    match /materials/{materialId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner() && request.resource.data.projectId is string && isUserProject(request.resource.data.projectId);
      allow update: if (isExistingDocOwner() && isCreatingWithOwner() && isOwnerImmutable() && isProjectImmutable()) ||
        isAdminMaterialReconciliationAuthorized(materialId);
      allow delete: if isAdminMaterialDeletionAuthorized(resource.data.projectId, materialId) ||
        (isExistingDocOwner() &&
        resource.data.totalPurchased == 0 &&
        resource.data.totalUsed == 0);
    }

    // 5. Purchases
    match /purchases/{purchaseId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner() &&
        request.resource.data.projectId is string &&
        isUserProject(request.resource.data.projectId) &&
        isValidProjectMaterial(request.resource.data.materialId, request.resource.data.projectId);
      allow update: if isExistingDocOwner() &&
        isCreatingWithOwner() &&
        isOwnerImmutable() &&
        isProjectImmutable() &&
        isValidProjectMaterial(request.resource.data.materialId, request.resource.data.projectId);
      allow delete: if isAdminTransactionDeletionAuthorized('Purchase', purchaseId);
    }

    // 6. Material Usage
    match /materialUsage/{usageId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner() && request.resource.data.projectId is string && isUserProject(request.resource.data.projectId);
      allow update: if isExistingDocOwner() && isCreatingWithOwner() && isOwnerImmutable() && isProjectImmutable();
      allow delete: if isAdminTransactionDeletionAuthorized('MaterialUsage', usageId);
    }

    // 6. Contractors
    match /contractors/{contractorId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner() && request.resource.data.projectId is string && isUserProject(request.resource.data.projectId);
      allow update: if (isExistingDocOwner() && isCreatingWithOwner() && isOwnerImmutable() && isProjectImmutable()) || isAdminContractorReconciliationAuthorized(contractorId);
      allow delete: if isAdminTransactionDeletionAuthorized('Contractor', contractorId);
    }

    // 7. Labour Payments
    match /labourPayments/{paymentId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner() && request.resource.data.projectId is string && isUserProject(request.resource.data.projectId);
      allow update: if isExistingDocOwner() && isCreatingWithOwner() && isOwnerImmutable() && isProjectImmutable();
      allow delete: if isAdminTransactionDeletionAuthorized('LabourPayment', paymentId);
    }

    // 9. Transportation & Haulage
    match /transportation/{transportId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner() && request.resource.data.projectId is string && isUserProject(request.resource.data.projectId);
      allow update: if isExistingDocOwner() && isCreatingWithOwner() && isOwnerImmutable() && isProjectImmutable();
      allow delete: if isAdminTransactionDeletionAuthorized('Transportation', transportId) ||
        (resource.data.purchaseId is string && isAdminPurchaseDeletionAuthorized(resource.data.purchaseId));
    }

    // 9. Other Site Expenses
    match /otherExpenses/{expenseId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner() && request.resource.data.projectId is string && isUserProject(request.resource.data.projectId);
      allow update: if isExistingDocOwner() && isCreatingWithOwner() && isOwnerImmutable() && isProjectImmutable();
      allow delete: if isAdminTransactionDeletionAuthorized('OtherExpense', expenseId);
    }

    // 10. Work Progress Milestones
    match /workProgress/{progressId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner() && request.resource.data.projectId is string && isUserProject(request.resource.data.projectId);
      allow update: if isExistingDocOwner() && isCreatingWithOwner() && isOwnerImmutable() && isProjectImmutable();
      allow delete: if isAdminTransactionDeletionAuthorized('WorkProgress', progressId);
    }

    // 11. Category Budgets
    match /categoryBudgets/{budgetId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if isCreatingWithOwner() && request.resource.data.projectId is string && isUserProject(request.resource.data.projectId);
      allow update: if isExistingDocOwner() && isCreatingWithOwner() && isOwnerImmutable() && isProjectImmutable();
      allow delete: if isExistingDocOwner();
    }

    // 13. Audit Events (strictly append-only: create allowed, update denied, delete denied)
    match /auditEvents/{eventId} {
      allow read: if isExistingDocOwner() || isAdmin();
      allow create: if (isCreatingWithOwner() &&
        request.resource.data.projectId is string &&
        isUserProject(request.resource.data.projectId)) ||
        (isAdmin() &&
        request.resource.data.projectId is string &&
        exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) &&
        request.resource.data.ownerId == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId &&
        request.resource.data.user == request.auth.uid);
      allow update: if false; // Append-only audit events
      allow delete: if false; // Denied per Requirement 4
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
